            'spotify-top-50-world',
            VAR R =
                TRIM(
                    'spotify-top-50-world'[release_date] & ""
                )
            VAR ReleaseDate =
                SWITCH(
                    TRUE(),

                    LEN(R) >= 10 &&
                    MID(R,5,1) = "-" &&
                    MID(R,8,1) = "-",
                        DATE(
                            VALUE(LEFT(R,4)),
                            VALUE(MID(R,6,2)),
                            VALUE(MID(R,9,2))
                        ),

                    LEN(R) = 7 &&
                    MID(R,5,1) = "-",
                        DATE(
                            VALUE(LEFT(R,4)),
                            VALUE(RIGHT(R,2)),
                            1
                        ),

                    LEN(R) = 4 &&
                    NOT ISERROR(VALUE(R)),
                        DATE(
