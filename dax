        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[position] <= 10,
        'spotify-top-50-world'[is_explicit] = TRUE()
    )

MEASURE 'spotify-top-50-world'[Explicit Top 10 Percentage] =
    DIVIDE(
        [Explicit Top 10 Entries],
