DEFINE

/* =========================================================
   1. BASIC DATASET KPIs
   ========================================================= */

MEASURE 'spotify-top-50-world'[Total Chart Entries] =
    COUNTROWS('spotify-top-50-world')

MEASURE 'spotify-top-50-world'[Chart Days] =
    DISTINCTCOUNT('spotify-top-50-world'[date])

MEASURE 'spotify-top-50-world'[Average Entries Per Day] =
    DIVIDE(
        [Total Chart Entries],
        [Chart Days]
    )

MEASURE 'spotify-top-50-world'[Distinct Songs] =
    DISTINCTCOUNT('spotify-top-50-world'[song])

MEASURE 'spotify-top-50-world'[Distinct Artists] =
    DISTINCTCOUNT('spotify-top-50-world'[artist])

MEASURE 'spotify-top-50-world'[Distinct Albums] =
    DISTINCTCOUNT('spotify-top-50-world'[album_cover_url])

MEASURE 'spotify-top-50-world'[Songs Per Artist] =
    DIVIDE(
        [Distinct Songs],
        [Distinct Artists]
    )

MEASURE 'spotify-top-50-world'[Artists Per Song] =
    DIVIDE(
        [Distinct Artists],
        [Distinct Songs]
    )

MEASURE 'spotify-top-50-world'[Chart Coverage Days] =
    DATEDIFF(
        MIN('spotify-top-50-world'[date]),
        MAX('spotify-top-50-world'[date]),
        DAY
    ) + 1


/* =========================================================
   2. CHART POSITION
   ========================================================= */

MEASURE 'spotify-top-50-world'[Average Chart Position] =
    AVERAGE('spotify-top-50-world'[position])

MEASURE 'spotify-top-50-world'[Median Chart Position] =
    MEDIAN('spotify-top-50-world'[position])

MEASURE 'spotify-top-50-world'[Best Chart Position] =
    MIN('spotify-top-50-world'[position])

MEASURE 'spotify-top-50-world'[Worst Chart Position] =
    MAX('spotify-top-50-world'[position])

MEASURE 'spotify-top-50-world'[Number 1 Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[position] = 1
    )

MEASURE 'spotify-top-50-world'[Top 5 Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[position] <= 5
    )

MEASURE 'spotify-top-50-world'[Top 10 Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[position] <= 10
    )

MEASURE 'spotify-top-50-world'[Top 25 Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[position] <= 25
    )

MEASURE 'spotify-top-50-world'[Top 50 Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[position] <= 50
    )

MEASURE 'spotify-top-50-world'[Number 1 Percentage] =
    DIVIDE(
        [Number 1 Entries],
        [Total Chart Entries]
    )

MEASURE 'spotify-top-50-world'[Top 5 Percentage] =
    DIVIDE(
        [Top 5 Entries],
        [Total Chart Entries]
    )

MEASURE 'spotify-top-50-world'[Top 10 Percentage] =
    DIVIDE(
        [Top 10 Entries],
        [Total Chart Entries]
    )

MEASURE 'spotify-top-50-world'[Top 25 Percentage] =
    DIVIDE(
        [Top 25 Entries],
        [Total Chart Entries]
    )


/* =========================================================
   3. POPULARITY
   ========================================================= */

MEASURE 'spotify-top-50-world'[Average Popularity] =
    AVERAGE('spotify-top-50-world'[popularity])

MEASURE 'spotify-top-50-world'[Median Popularity] =
    MEDIAN('spotify-top-50-world'[popularity])

MEASURE 'spotify-top-50-world'[Maximum Popularity] =
    MAX('spotify-top-50-world'[popularity])

MEASURE 'spotify-top-50-world'[Minimum Popularity] =
    MIN('spotify-top-50-world'[popularity])

MEASURE 'spotify-top-50-world'[Highly Popular Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[popularity] >= 90
    )

MEASURE 'spotify-top-50-world'[Highly Popular Percentage] =
    DIVIDE(
        [Highly Popular Entries],
        [Total Chart Entries]
    )

MEASURE 'spotify-top-50-world'[Popular Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[popularity] >= 80
    )

MEASURE 'spotify-top-50-world'[Popular Percentage] =
    DIVIDE(
        [Popular Entries],
        [Total Chart Entries]
    )

MEASURE 'spotify-top-50-world'[Low Popularity Entries] =
    CALCULATE(
        COUNTROWS('spotify-top-50-world'),
        'spotify-top-50-world'[popularity] < 50
    )

MEASURE 'spotify-top-50-world'[Top 10 Average Popularity] =
    CALCULATE(
        AVERAGE('spotify-top-50-world'[popularity]),
        'spotify-top-50-world'[position] <= 10
    )

MEASURE 'spotify-top-50-world'[Top 10 Median Popularity] =
    CALCULATE(
        MEDIAN('spotify-top-50-world'[popularity]),
        'spotify-top-50-world'[position] <= 10
    )

MEASURE 'spotify-top-50-world'[Popularity Position Correlation] =
    VAR AvgP =
        AVERAGE('spotify-top-50-world'[position])
    VAR AvgPop =
        AVERAGE('spotify-top-50-world'[popularity])
    VAR Numerator =
        SUMX(
            'spotify-top-50-world',
            (
                'spotify-top-50-world'[position] - AvgP
            )
            *
            (
                'spotify-top-50-world'[popularity] - AvgPop
            )
        )
    VAR Denominator =
        SQRT(
            SUMX(
                'spotify-top-50-world',
                POWER(
                    'spotify-top-50-world'[position] - AvgP,
                    2
                )
            )
            *
            SUMX(
                'spotify-top-50-world',
                POWER(
                    'spotify-top-50-world'[popularity] - AvgPop,
                    2
                )
            )
        )
    RETURN
        DIVIDE(
            Numerator,
            Denominator
        )


/* =========================================================
   4. SONG APPEARANCE / RETENTION
   ========================================================= */

MEASURE 'spotify-top-50-world'[Average Song Appearances] =
    DIVIDE(
