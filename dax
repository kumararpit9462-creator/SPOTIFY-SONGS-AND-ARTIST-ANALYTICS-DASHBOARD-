/* =========================================================
   10. RELEASE DATE
   Handles:
   YYYY
   YYYY-MM
   YYYY-MM-DD
   ========================================================= */

MEASURE 'spotify-top-50-world'[Earliest Release Date] =
VAR ParsedDates =
    ADDCOLUMNS(
        'spotify-top-50-world',
        "__ReleaseDate",
            VAR R =
                TRIM(
                    'spotify-top-50-world'[release_date] & ""
                )
            RETURN
                SWITCH(
                    TRUE(),

                    /* YYYY-MM-DD */
                    LEN(R) >= 10 &&
                    MID(R,5,1) = "-" &&
                    MID(R,8,1) = "-" &&
                    NOT ISERROR(
                        DATE(
                            VALUE(LEFT(R,4)),
                            VALUE(MID(R,6,2)),
                            VALUE(MID(R,9,2))
                        )
                    ),
                        DATE(
                            VALUE(LEFT(R,4)),
                            VALUE(MID(R,6,2)),
                            VALUE(MID(R,9,2))
                        ),

                    /* YYYY-MM */
                    LEN(R) = 7 &&
                    MID(R,5,1) = "-" &&
                    NOT ISERROR(
                        DATE(
                            VALUE(LEFT(R,4)),
                            VALUE(RIGHT(R,2)),
                            1
                        )
                    ),
                        DATE(
                            VALUE(LEFT(R,4)),
                            VALUE(RIGHT(R,2)),
                            1
                        ),

                    /* YYYY */
                    LEN(R) = 4 &&
                    NOT ISERROR(
                        VALUE(R)
                    ),
                        DATE(
                            VALUE(R),
                            1,
                            1
                        ),

                    BLANK()
                )
    )
RETURN
    MINX(
        FILTER(
            ParsedDates,
            NOT ISBLANK([__ReleaseDate])
        ),
        [__ReleaseDate]
    )


